# ===== AbanTour Social Agent — Environment Variables =====
# Copy this file to ".env" and fill REAL values. NEVER paste secrets in chat.

# --- OpenAI (caption/hook engine + Sora video) ---
OPENAI_API_KEY=«redacted:sk-…»

# --- Telegram (posting bot) ---
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ
# Private approval channel numeric ID
TELEGRAM_CHANNEL_PRIVATE=-1001234567890
# Public channel username (without @) or numeric ID
TELEGRAM_CHANNEL_PUBLIC=abantour_agency

# --- Bale (Iran-friendly alternative) ---
BALE_BOT_TOKEN=your_bale_bot_token
BALE_CHANNEL=@abantour_bale   # or numeric ID

# --- Control bot (admin, runs on Render) ---
# Comma-separated admin user IDs (Telegram + Bale admin)
ADMIN_IDS=67391189,1507774562

# --- Instagram (official Graph API) ---
INSTAGRAM_TOKEN=IGQVJ...long_lived_token...
INSTAGRAM_PAGE_ID=17841400000000000
INSTAGRAM_APP_ID=your_fb_app_id
INSTAGRAM_APP_SECRET=your_fb_app_secret

# --- Render orchestrator <-> PC producer ---
# Shared secret so only your PC can push staged content to Render
STAGE_TOKEN=choose_a_long_random_string
# Public URL of the deployed Render service (set after first deploy)
RENDER_BASE=https://your-service.onrender.com

# --- Media host (for public video URLs needed by Instagram) ---
# catbox | r2 | ftp
MEDIA_HOST_BACKEND=catbox
